	"tweaks": [
		{"id": "silent_apps", "group": "apps", "icon": "shield", "rec": true,
			"name": "Stop Windows installing suggested apps", "desc": "Keeps games and promos like these from quietly coming back.",
			"ops": [
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEnabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "PreInstalledAppsEverEnabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "OemPreInstalledAppsEnabled", "type": "DWord", "value": 0}
			]},
		{"id": "game_mode", "group": "perf", "icon": "gamepad", "rec": true,
			"name": "Game Mode on", "desc": "Windows puts the game first and holds back updates and background work while you play.",
			"ops": [{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled", "type": "DWord", "value": 1}]},
		{"id": "game_dvr", "group": "perf", "icon": "monitor", "rec": true,
			"name": "No background game recording", "desc": "Xbox Game Bar stops recording behind every game, a common cause of lost frames.",
			"ops": [
				{"t": "reg", "path": "HKCU:\\System\\GameConfigStore", "name": "GameDVR_Enabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR", "name": "AppCaptureEnabled", "type": "DWord", "value": 0}
			]},
		{"id": "startup_delay", "group": "perf", "icon": "bolt", "rec": true,
			"name": "Start apps without the wait", "desc": "Windows normally holds startup apps back for a few seconds after you sign in.",
			"ops": [{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize", "name": "StartupDelayInMSec", "type": "DWord", "value": 0}]},
		{"id": "menu_delay", "group": "perf", "icon": "sparkles", "rec": true,
			"name": "Snappier menus", "desc": "Windows' own menus open in 100 ms instead of 400. After you next sign in.",
			"ops": [{"t": "reg", "path": "HKCU:\\Control Panel\\Desktop", "name": "MenuShowDelay", "type": "String", "value": "100"}]},
		{"id": "power_plan", "group": "perf", "icon": "power", "rec": true,
			"name": "High performance power plan", "desc": "Your processor stays ready instead of dozing between frames.",
			"ops": [{"t": "power", "scheme": "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c"}]},
		{"id": "background_apps", "group": "perf", "icon": "layers", "rec": false,
			"name": "Store apps stay closed in the background", "desc": "Saves memory and battery, but apps like WhatsApp won't notify you while closed.",
			"ops": [
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\BackgroundAccessApplications", "name": "GlobalUserDisabled", "type": "DWord", "value": 1},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "BackgroundAppGlobalToggle", "type": "DWord", "value": 0}
			]},
		{"id": "raw_mouse", "group": "perf", "icon": "gamepad", "rec": false,
			"name": "Raw mouse movement", "desc": "Turns off pointer acceleration, so aim feels the same at any speed. After you next sign in.",
			"ops": [
				{"t": "reg", "path": "HKCU:\\Control Panel\\Mouse", "name": "MouseSpeed", "type": "String", "value": "0"},
				{"t": "reg", "path": "HKCU:\\Control Panel\\Mouse", "name": "MouseThreshold1", "type": "String", "value": "0"},
				{"t": "reg", "path": "HKCU:\\Control Panel\\Mouse", "name": "MouseThreshold2", "type": "String", "value": "0"}
			]},
		{"id": "ads", "group": "privacy", "icon": "sparkles", "rec": true,
			"name": "No ads or suggestions in Windows", "desc": "Start, Settings, the lock screen and File Explorer stop recommending things to buy or try.",
			"ops": [
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SystemPaneSuggestionsEnabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338388Enabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338389Enabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-310093Enabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338393Enabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-353694Enabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-353696Enabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SoftLandingEnabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "RotatingLockScreenOverlayEnabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_IrisRecommendations", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowSyncProviderNotifications", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\UserProfileEngagement", "name": "ScoobeSystemSettingEnabled", "type": "DWord", "value": 0}
			]},
		{"id": "ad_id", "group": "privacy", "icon": "user", "rec": true,
			"name": "Advertising ID off", "desc": "Apps can't follow you around with a shared ad profile.",
			"ops": [{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "name": "Enabled", "type": "DWord", "value": 0}]},
		{"id": "tailored", "group": "privacy", "icon": "info", "rec": true,
			"name": "No tailored experiences", "desc": "Microsoft stops using your diagnostic data to pick tips and offers for you.",
			"ops": [{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Privacy", "name": "TailoredExperiencesWithDiagnosticDataEnabled", "type": "DWord", "value": 0}]},
		{"id": "telemetry", "group": "privacy", "icon": "globe", "rec": true,
			"name": "Send Microsoft only required diagnostics", "desc": "The lowest level Windows allows, and its telemetry service stops running.",
			"ops": [
				{"t": "reg", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "type": "DWord", "value": 1},
				{"t": "service", "name": "DiagTrack", "start": "Disabled"}
			]},
		{"id": "web_search", "group": "privacy", "icon": "search", "rec": true,
			"name": "No Bing in Windows search", "desc": "Searching from Windows stays on your PC. Oazy's Start search is unaffected.",
			"ops": [
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "BingSearchEnabled", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Policies\\Microsoft\\Windows\\Explorer", "name": "DisableSearchBoxSuggestions", "type": "DWord", "value": 1}
			]},
		{"id": "activity", "group": "privacy", "icon": "clock", "rec": true,
			"name": "No activity history", "desc": "Windows stops keeping a timeline of the apps and files you use.",
			"ops": [
				{"t": "reg", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "PublishUserActivities", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "UploadUserActivities", "type": "DWord", "value": 0}
			]},
		{"id": "recall", "group": "privacy", "icon": "image", "rec": true,
			"name": "Recall snapshots off", "desc": "Windows won't screenshot what you do (Copilot+ PCs).",
			"ops": [{"t": "reg", "path": "HKCU:\\Software\\Policies\\Microsoft\\Windows\\WindowsAI", "name": "DisableAIDataAnalysis", "type": "DWord", "value": 1}]},
		{"id": "typing", "group": "privacy", "icon": "keyboard", "rec": true,
			"name": "Keep typing and handwriting private", "desc": "Windows stops collecting what you type and write to train its dictionary.",
			"ops": [
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\InputPersonalization", "name": "RestrictImplicitTextCollection", "type": "DWord", "value": 1},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\InputPersonalization", "name": "RestrictImplicitInkCollection", "type": "DWord", "value": 1},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\InputPersonalization\\TrainedDataStore", "name": "HarvestContacts", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Personalization\\Settings", "name": "AcceptedPrivacyPolicy", "type": "DWord", "value": 0}
			]},
		{"id": "feedback", "group": "privacy", "icon": "alert", "rec": true,
			"name": "No feedback pop-ups", "desc": "Windows stops asking how it's doing.",
			"ops": [
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Siuf\\Rules", "name": "NumberOfSIUFInPeriod", "type": "DWord", "value": 0},
				{"t": "reg", "path": "HKCU:\\Software\\Microsoft\\Siuf\\Rules", "name": "PeriodInNanoSeconds", "type": "QWord", "value": 0}
			]}
	],
	"junk": [
		{"id": "user_temp", "icon": "document", "rec": true, "name": "Temporary files", "desc": "Left behind by apps and installers. Anything used in the last day stays.",
			"paths": ["%TEMP%"], "min_age_hours": 24},
		{"id": "win_temp", "icon": "monitor", "rec": true, "admin": true, "name": "Windows temporary files", "desc": "Windows' own leftovers. Anything used in the last day stays.",
			"paths": ["%SystemRoot%\\Temp"], "min_age_hours": 24},
		{"id": "crash", "icon": "alert", "rec": true, "name": "Crash dumps and error reports", "desc": "Saved after apps crash, already sent or never needed.",
			"paths": ["%LOCALAPPDATA%\\CrashDumps", "%LOCALAPPDATA%\\Microsoft\\Windows\\WER\\ReportArchive", "%LOCALAPPDATA%\\Microsoft\\Windows\\WER\\ReportQueue"], "min_age_hours": 0},
		{"id": "browser", "icon": "globe", "rec": false, "name": "Browser caches", "desc": "Chrome, Edge and Brave rebuild them as you browse. Skipped while a browser is open. Logins and history stay.",
			"paths": [
				"%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Cache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\Code Cache", "%LOCALAPPDATA%\\Google\\Chrome\\User Data\\*\\GPUCache",
				"%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Cache", "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\Code Cache", "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data\\*\\GPUCache",
				"%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Cache", "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\Code Cache", "%LOCALAPPDATA%\\BraveSoftware\\Brave-Browser\\User Data\\*\\GPUCache"
			], "min_age_hours": 0, "skip_if_running": ["chrome", "msedge", "brave"]},
		{"id": "recycle", "icon": "trash", "rec": false, "name": "Recycle Bin", "desc": "Files you deleted. Emptying it is permanent.", "recycle": true}
	]
}
